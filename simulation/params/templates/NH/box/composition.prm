subsection Boundary composition model
  set List of model names                   = function
  set Fixed composition boundary indicators = top

  subsection Function
    set Variable names      = x, y
    set Function expression = (y<{transition-ol-wd} ? 1 : 0); \
                              3200; \
                              2.0e+09 + 3900*10.0*(1.0e+06-y)
  end
end

subsection Compositional fields
  set Number of fields            = 3
  set Names of fields             = xi_ol_wd, density_field, relaxed_pressure
  set Compositional field methods = field, prescribed field, field
end
